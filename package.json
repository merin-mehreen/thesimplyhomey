{
  "name": "homey-store",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "node --test tests/*.test.mjs",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "seed:local": "wrangler d1 execute DB --local --file=seed.sql",
    "seed:remote": "wrangler d1 execute DB --remote --file=seed.sql",
    "storage:enable": "node scripts/enable-media.mjs",
    "domains:test": "node scripts/configure-domains.mjs test",
    "domains:production": "node scripts/configure-domains.mjs production",
    "domains:both": "node scripts/configure-domains.mjs both"
  },
  "devDependencies": {
    "wrangler": "4.156.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "npm@11.9.0"
}
