{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "temp",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-31",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none",
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "migrations_dir": "migrations"
    }
  ],
  "build": {
    "command": "npm run build"
  }
}
