{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "homey-store",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-31",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "homey-store", "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "homey-media" }]
}
